MiniWindow
  id: battleWindow
  !text: tr('Battle')
  height: 120
  icon: /images/topbuttons/battle
  @onClose: modules.game_battle.onMiniWindowClose()
  &save: true
  &autoOpen: false

  MiniWindowContents
    Panel
      id: battlePanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      margin-top: 3
      padding-right: 5
      layout:
        type: verticalBox
        fit-children: true
