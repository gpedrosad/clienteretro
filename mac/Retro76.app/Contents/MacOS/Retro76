#!/bin/bash
# Lanzador de Retro76.app. El cliente (otclient_mac + data.zip) va en Contents/Resources: publish_client.py
# de serverrepo los copia ahí al armar Retro76-Mac.zip. El binario busca data.zip en la carpeta actual.
RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
APP="$(cd "$RES/../.." && pwd)"

aviso() {
  osascript -e "display dialog \"$1\" buttons {\"OK\"} default button 1 with title \"Retro76\" with icon caution" >/dev/null 2>&1
}

# macOS abre las apps recién descargadas desde una copia de solo lectura (App Translocation) hasta que se
# mueven con el Finder. Desde ahí no se puede quitar la cuarentena del binario.
case "$APP" in
  */AppTranslocation/*)
    aviso "Antes de jugar, arrastrá Retro76.app a la carpeta Aplicaciones (o a cualquier otra carpeta) y abrilo desde ahí."
    exit 0 ;;
esac

if [ ! -e /opt/X11/lib/libX11.6.dylib ]; then  # otclient_mac está enlazado contra la X11 de XQuartz
  aviso "Retro76 necesita XQuartz. Se va a abrir xquartz.org: instalalo, reiniciá la sesión y volvé a abrir Retro76."
  open "https://www.xquartz.org/"
  exit 0
fi

open -a XQuartz
sleep 3
for d in /private/tmp/com.apple.launchd.*/org.xquartz:0; do
  if [ -e "$d" ]; then export DISPLAY="$d"; break; fi
done
if [ -z "$DISPLAY" ]; then export DISPLAY=:0; fi

xattr -dr com.apple.quarantine "$APP" 2>/dev/null
chmod +x "$RES/otclient_mac"
cd "$RES" && exec ./otclient_mac
